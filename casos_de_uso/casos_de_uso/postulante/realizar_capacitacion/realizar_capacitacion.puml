@startuml
title Caso de uso: Realizar Capacitación

actor Postulante

rectangle "Sistema de Capacitación" {
    usecase "Abrir Capacitación" as UC1
    usecase "Completar Tarea" as UC2
    usecase "Ver Notificación" as UC3
}

Postulante --> UC1
Postulante --> UC2
Postulante --> UC3

note right of UC1
    El usuario selecciona una
    capacitación de la lista
end note

note right of UC2
    El usuario completa las
    tareas asignadas
end note

note right of UC3
    El sistema notifica la
    finalización 
end note

@enduml