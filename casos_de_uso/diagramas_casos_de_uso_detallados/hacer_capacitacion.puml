@startuml
title Detallado del Hacer Capacitación

start

:VISTA_HACER_CAPACITACION;

partition ManejoHacerCapacitacion {
  
  :Postulante/Becario solicita acceder a capacitaciones
  • Ve lista de capacitaciones disponibles;

  :Sistema permite acceder a capacitaciones;
  
  :Postulante/Becario selecciona capacitación
  • Lee descripción completa;

  
  :Sistema verifica elegibilidad
  • Cumple requisitos previos;
  
  
  if (¿Cumple requisitos?) then (No)
    :Sistema muestra
    • Error: "No cumple requisitos"
    • Detalles específicos:
      - Requisitos faltantes
      - Capacitaciones previas necesarias;
    
    
  else (Sí)
    :Postulante/Becario solicita acceder a contenido
      • Videos y recursos;
    
    :Sistema permite acceder a contenido;
    
  endif
  
}

stop
@enduml