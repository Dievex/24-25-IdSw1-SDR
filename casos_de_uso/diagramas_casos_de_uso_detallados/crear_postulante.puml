@startuml
title Detallado del Crear Postulante

start

:VISTA_CREAR_POSTULANTE;

partition ManejoCrearPostulante {
  
  :Administrador introduce
  • Nombre completo
  • Email
  • Dirección
  • Pasaporte
  • Tipo de usuario
  • Contraseña;

  
  :Sistema valida los datos
  • Formato de email
  • Campos obligatorios;
  
  if (¿Datos válidos?) then (No)
    :Sistema muestra
    • Error: "Datos inválidos";
   
  
    
  else (Sí)
    if (¿Usuario ya existe?) then (Sí)
      :Sistema muestra
      • Error: "Usuario ya registrado"
      • Opción: "Ver perfil existente";
      
    else (No)
      :Sistema crea el usuario
      • Asigna ID único
      • Genera número de Usuario
      • Asigna Tipo de Usuario "Postulante"
      • Guarda en base de datos
      • Crea perfil básico;
      
      :Sistema muestra
      • Mensaje: "Postulante creado exitosamente"
      • Número de registro asignado
      • Redirige a perfil del postulante;
      
    endif
    
  endif
  
}

stop
@enduml