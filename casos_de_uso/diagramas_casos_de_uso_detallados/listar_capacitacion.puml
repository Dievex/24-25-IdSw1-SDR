@startuml
title Detallado del Listar Capacitación

start

:VISTA_LISTAR_CAPACITACION;

partition ManejoListarCapacitacion {
  
  :Sistema carga las capacitaciones
  • Consulta base de datos
  • Obtiene lista completa;
  
  if (¿Existen capacitaciones?) then (No)
    :Sistema muestra
    • Mensaje: "No hay capacitaciones disponibles"
    • Opción para crear nueva;
    
  else (Sí)
    :Sistema muestra
    • Lista de capacitaciones
    • Nombre, duracion, estado
    • Opciones de acción (Ver, Editar, Eliminar);
    

    
  endif
  
}

stop
@enduml