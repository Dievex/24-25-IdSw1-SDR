@startuml
title Detallado del Cerrar Sesión

start

:VISTA_CERRAR_SESION;

partition ManejoCerrarSesion {
  
  :Usuario solicita cerrar sesión;


  :Sistema verifica estado actual
  • Sesión activa válida
  • Test en ejecución
  • Procesos en ejecución;
  
  
  if (¿Hay procesos activos?) then (Sí)
    :Sistema verifica criticidad
    • Tests en progreso
    • Cargas de archivos
    • Capacitaciones en curso;
    
    :Sistema maneja procesos
    • Espera finalización automática
    • O permite forzar cierre
    • Con advertencias apropiadas;
    
  endif
  
  :Sistema procesa cierre de sesión
    • Solicita confirmación;

    if (¿Usuario confirma?) then (Sí)
      :Sistema cierra sesión;
      :VISTA_INICIAR_SESION;
    else (No)
      :Sistema mantiene sesión activa;
    endif
  
}

stop
@enduml