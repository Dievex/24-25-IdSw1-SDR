@startuml
title Detallado del Listar Test

start

:VISTA_LISTAR_TEST;

partition ManejoListarTest {

  :Usuario solicita ver los tests;
  
  :Sistema identifica tipo de usuario
  • Administrador: ve todos los tests
  • Postulante: ve tests activos/asignados;
  
  :Sistema carga tests según permisos;
  
  
  if (¿Existen tests?) then (No)
    if (¿Es Administrador?) then (Sí)
      :Sistema muestra
      • Mensaje: "No hay tests creados";

      :CREAR_TEST;
     
      
    else (No - Postulante)
      :Sistema muestra
      • Mensaje: "No hay tests disponibles";
    
      
    endif
    
  else (Sí)
    if (¿Es Administrador?) then (Sí)
      :Sistema muestra lista completa
      • Nombre, estado, duración
      • Número de preguntas
      • Fecha de creación/modificación
      • Estadísticas de uso
      • Opciones: Ver/Editar/Eliminar/Duplicar;
      
      :Administrador puede
      • Ver resultados por test;
      
    else (No - Postulante)
      :Sistema muestra tests disponibles
      • Solo tests activos
      • Tests no realizados
      • Duración estimada
      • Fecha límite (si aplica)
      • Estado: Pendiente/Completado;
      
      :Postulante puede
      • Ver detalles del test
      • Iniciar test disponible
      • Ver resultados completados;
      
      
      if (¿Postulante inicia test?) then (Sí)
        :HACER_TEST;
        
      endif
      
    endif
    
  endif
  
}

stop
@enduml