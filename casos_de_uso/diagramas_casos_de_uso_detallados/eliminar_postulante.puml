@startuml
title Detallado del Eliminar Postulante

start

:VISTA_ELIMINAR_POSTULANTE;

partition ManejoEliminarPostulante {
  
  :Administrador selecciona postulante
  • Desde lista o perfil
  • Hace clic en "Eliminar"
  • Sistema verifica permisos;
  
  :Sistema verifica dependencias
  • Inscripciones en capacitaciones
  • Evaluaciones realizadas;

  
  if (¿Tiene dependencias activas?) then (Sí)
    :Sistema muestra opciones
    • Error: "No se puede eliminar"
    • Dependencias encontradas:
      - Capacitaciones Vistas: X
      - Evaluaciones: Z
    • Opción: "Desactivar postulante";
    
    if (¿Usuario elige desactivar?) then (Sí)
      :Sistema desactiva postulante
      • Cambia estado a "Inactivo"
      • Mantiene historial
      • Registra motivo;
      
      :Sistema muestra
      • Mensaje: "Postulante desactivado"
      • Opción: "Reactivar en el futuro";
      
    else (No)
      :Sistema cancela operación
      • Vuelve a vista anterior
      • Mantiene datos intactos;
      
    endif
    
  else (No)
    :Sistema muestra confirmación
    • Pregunta: "¿Eliminar permanentemente?"
    • Datos del postulante
    • Advertencia: "Acción irreversible"
    • Botones: Confirmar/Cancelar;
    
    if (¿Administrador confirma?) then (No)
      :Sistema cancela operación
      • Vuelve a lista de postulantes;
      
    else (Sí)
      :Sistema elimina postulante
      • Borra de base de datos
      • Elimina archivos asociados
      • Registra en log de auditoría;
    
      
      :Sistema muestra
      • Mensaje: "Postulante eliminado"
      • Actualiza lista automáticamente;
      
    endif
    
  endif
  
}

stop
@enduml