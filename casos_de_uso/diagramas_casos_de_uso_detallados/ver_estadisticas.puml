@startuml
title Detallado del Ver Estadísticas

start

:VISTA_ESTADISTICAS;

partition ManejoVerEstadisticas {
  
  :Administrador/Seleccionador accede al módulo
  • Selecciona "Estadísticas";

  
  :Sistema carga dashboard
  • Conecta con base de datos
  • Procesa información;
  
  if (¿Datos disponibles?) then (No)
    :Sistema muestra
    • Error: "No hay datos suficientes"
    • Mensaje: "Seleccione otro período"
    • Opciones de filtro;
    
  else (Sí)
    :Sistema genera estadísticas
    • Capacitaciones por mes/año
    • Porcentaje de aprobación
    • Número de postulantes/becarios;
  
 
    
    :Sistema muestra dashboard
    • Gráficos interactivos
    • Tablas resumen
    • Indicadores clave (KPIs)
    • Opciones de exportación;
    
 
    
    if (¿Usuario exporta?) then (Sí)
      :Sistema genera reporte
      • Formato seleccionado
      • Descarga automática;
      
    else (No)
      :Usuario continúa navegando
      • Actualiza filtros
      • Explora diferentes vistas;
      
    endif
    
  endif
  
}

stop
@end