@startuml
title Detallado del Editar Capacitación

start

:VISTA_EDITAR_CAPACITACION;

partition ManejoEditarCapacitacion {
  
  :Sistema muestra datos existentes;
  
  if (¿Capacitación existe?) then (No)
    :Sistema muestra
    • Error: "Capacitación no encontrada";
    
  else (Sí)
    :Administrador solicita modificar;
    
    :Sistema valida modificación;
    
    if (¿Datos válidos?) then (No)
      :Sistema muestra
      • Error: "Datos inválidos"
      • Mantiene formulario;
      
    else (Sí)
      :Sistema actualiza capacitación
      • Guarda cambios
      • Registra fecha de modificación;
      
      :Sistema muestra
      • Mensaje: "Capacitación actualizada"
      • Redirige a vista de detalle;
      
    endif
    
  endif
  
}

stop
@enduml