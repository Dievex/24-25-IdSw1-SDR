@startuml Diagrama_de_Objetos_Novus
hide circles
title Diagrama de Objetos de Plataforma Novus - Gestión de Becarios PROFER

skinparam {
    ObjectBackgroundColor #f0f8ff
    ObjectBorderColor #4682b4
    ObjectFontColor #000000
    ObjectFontSize 14
    ObjectAttributeFontColor #191970
    ObjectAttributeFontSize 12
}

' Definición de objetos con atributos

object "plataformaNovus : PLATAFORMA" as plataforma {
    nombre = "Novus"
    version = "1.0"
    fechaCreacion = "2024-02-15"
}

object "admin1 : ADMINISTRADOR" as admin {
    id = "ADM001"
    nombre = "Juan Pérez"
    email = "juan.perez@novus.com"
    rol = "Administrador Senior"
}

object "postulante1 : POSTULANTE" as postulante {
    id = "POS001"
    nombre = "María García"
    email = "maria.garcia@email.com"
    fechaRegistro = "2024-02-20"
    estado = "En evaluación"
}

object "becario1 : BECARIO" as becario {
    id = "BEC001"
    nombre = "Carlos López"
    email = "carlos.lopez@email.com"
    fechaInicioBeca = "2024-01-15"
    programaAsignado = "PROFER 2024"
}

object "testProgramacion : TEST" as test {
    id = "TEST001"
    titulo = "Evaluación Java Básico"
    duracion = "120 minutos"
    puntajeMinimo = 75
}

object "cursoJava : CAPACITACION" as capacitacion {
    id = "CAP001"
    titulo = "Fundamentos de Java"
    nivel = "Básico"
    duracion = "40 horas"
}

object "videoIntro : VIDEO_TUTORIAL" as video {
    id = "VID001"
    titulo = "Introducción a Java"
    duracion = "45 minutos"
    formato = "MP4"
}

object "manualJava : DOCUMENTACION" as doc {
    id = "DOC001"
    titulo = "Manual de Java"
    formato = "PDF"
    tamaño = "2.5 MB"
}

object "estadisticasMensuales : ESTADISTICA" as estadistica {
    id = "EST001"
    periodo = "Febrero 2024"
    tasaAprobacion = 75.5
    totalPostulantes = 100
    totalBecarios = 45
}

' Relaciones entre objetos
plataforma --> estadistica : genera
plataforma --> admin : gestiona
plataforma --> test : incluye
plataforma --> capacitacion : ofrece

admin --> plataforma : administra
admin --> capacitacion : gestiona
admin --> estadistica : consulta

capacitacion --> video : contiene
capacitacion --> doc : contiene

postulante --> test : realiza
test --> becario : aprobación convierte en

admin --> capacitacion : accede a
postulante --> capacitacion : accede a
becario --> capacitacion : accede a

@enduml